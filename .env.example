# Plantilla del entorno REAL: el servidor DATA de producción.
# Los valores salen de F0.3. Para desarrollo hay un stack local que se levanta
# con `npm run dev:stack`, pero es andamiaje: ver TECHNICAL-SPEC §18.2.
# ── Base de datos (TECHNICAL-SPEC §18.3) ───────────────────────────────
# Va por la IP PRIVADA del servidor DATA: Postgres no escucha en la interfaz
# pública (§2.4, verificado en F0.4). Secreto de servidor: sin NEXT_PUBLIC_.
DATABASE_URL=postgresql://usuario:clave@10.0.0.2:5432/anavende

# ── Supabase (Auth y Storage) ──────────────────────────────────────────
# Lo que lleva NEXT_PUBLIC_ se embebe en el bundle del navegador: solo la URL
# y la clave publicable, nunca la de servicio (§16).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.anavende.example
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de servicio: Admin API de Auth (§13.5) y Storage (§9.4). SOLO servidor.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=productos

# La clave que comparten la tienda y el nginx del servidor DATA para que GoTrue
# cuente los intentos por comprador y no por tienda (§16, F10.5). SOLO
# servidor. Es la de /etc/nginx/conf.d/anavende-cliente-ip.conf; vacía en
# desarrollo, y entonces no se manda nada.
SUPABASE_CLAVE_CLIENTE_IP=

# ── Sitio ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Turnstile (§16, F10.5b) ────────────────────────────────────────────
# La clave de sitio, pública: va en el navegador. El secreto NO va acá: lo
# usa GoTrue (GOTRUE_SECURITY_CAPTCHA_SECRET en el servidor DATA). Vacía, no
# hay widget. Para el stack local, la de prueba de Cloudflare que siempre
# aprueba: 1x00000000000000000000AA (ver supabase/config.toml).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Emails (§14) ───────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=AnaVende <hola@anavende.example>

# ── Observabilidad (§19) ───────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir los source maps al construir. En desarrollo van vacías.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
