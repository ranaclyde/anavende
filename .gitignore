# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env
# Los respaldos también llevan claves de verdad: el del stack local guarda la
# API key de Resend. Sin esta línea `.env.stack-local.bak` se commitea.
.env*.bak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ia
/.claude
/.impeccable

# La previsualización de los emails se regenera con `npm run email`. Lo que
# sí se commitea es `public/emails/*.html`, que es lo que descarga GoTrue.
public/emails/vista-previa/
