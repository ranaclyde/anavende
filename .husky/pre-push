# Lo que antes de cada push se corría a mano: los tipos y el build sin base.
# Un push a `main` despliega, y lo que rompe un despliegue es un build que
# falla en Coolify: esto lo frena antes. Para un apuro: `git push --no-verify`.
#
# Los tests no están, decisión tuya del 2026-11-18: eran unos 50 s de cada
# push y pedían el stack local levantado. Se corren antes de abrir cada PR, y
# `npm run test:coverage` cuando se quiera ver el número.
#
# Corre sobre la copia de trabajo, no solo sobre lo commiteado: si quedó algo
# sin commitear, se verifica con eso adentro.

# Si lo que se va a subir es solo documentación, no hay nada que compilar.
base=$(git merge-base HEAD origin/main 2>/dev/null)
if [ -n "$base" ]; then
  cambios=$(git diff --name-only "$base" HEAD)
  if [ -n "$cambios" ] && ! printf '%s\n' "$cambios" | grep -qvE '\.md$'; then
    echo "pre-push: solo cambió documentación, no corro nada."
    exit 0
  fi
fi

set -e

echo "pre-push: tipos"
npm run --silent typecheck

# En su propia carpeta y no en `.next`: un build ahí con `next dev` levantado
# ya le pisó la caché al servidor de desarrollo (`distDir` en
# `next.config.ts`). Y sin el token de Sentry de `.env.local`: con él, cada
# push crearía un release y subiría los mapas de un build que no se despliega.
echo "pre-push: build sin base"
NEXT_DIST_DIR=.next-verificacion SENTRY_AUTH_TOKEN= DATABASE_URL= npx next build
