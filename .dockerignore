# Lo que NO entra en la imagen. Cada línea de más acá es peso, tiempo de
# construcción y —en el caso de los .env— un secreto que viajaría dentro de
# una imagen que se guarda en un registro.

node_modules
.next
.git
.github

# Los secretos NUNCA entran. Las variables las inyecta Coolify en tiempo de
# ejecución (TECHNICAL-SPEC §16), y las NEXT_PUBLIC_* se pasan como --build-arg.
.env
.env.*
!.env.example
!.env.test.example

# Andamiaje de desarrollo: no lo necesita ni la construcción ni el arranque.
tests
playwright-report
test-results
supabase
scripts/*.mts
.claude
.impeccable
sdd
*.bak
tsconfig.tsbuildinfo
PROGRESO.md
VERSIONS.md
README.md
